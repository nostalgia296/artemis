<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 动态取色（Material You）：
         图标背景/前景对应主题的 primary/onPrimary，
         启动页背景/图标对应主题的 surface/primary，随壁纸变化。 -->
    <color name="ic_launcher_background">@android:color/system_accent1_600</color>
    <color name="ic_launcher_foreground_dynamic">@android:color/system_accent1_0</color>
    <color name="splash_background">@android:color/system_neutral1_10</color>
    <color name="splash_icon_color">@android:color/system_accent1_600</color>
</resources>
